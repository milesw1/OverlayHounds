# Optional server-wide Broadcast PIN protecting Studio, Phone Scorekeeper,
# asset uploads/deletes, and Saved Teams presets.
# Moblin overlays (?overlay=true) always remain open and read-only.
ADMIN_PIN=

# Optional single persistent volume directory for BOTH /data and uploaded /assets.
# On Railway, attaching a Volume mounted at /storage automatically sets
# RAILWAY_VOLUME_MOUNT_PATH=/storage (no manual variable needed), or set
# STORAGE_DIR=/storage explicitly on Render, Fly.io, Docker, or Raspberry Pi.
STORAGE_DIR=
